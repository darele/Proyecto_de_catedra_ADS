<?xml version="1.0" encoding="UTF-8"?>
<!--
    Descriptor de despliegue. Versión 3.1, la que soporta Tomcat 8.5; con la 4.0 Tomcat
    mostraba "Unknown version string [4.0]".

    Como en eshopx (libro, Capítulos 7 y 10), los controladores se declaran y mapean aquí y
    no con @WebServlet (el Capítulo 5 usa la anotación). Así servlets, parámetros y páginas
    de error quedan en un solo archivo.
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>RBO - Sistema de Control de Asistencia</display-name>

    <!--
        Modo desarrollo: si es true, /admin y /rh se abren sin login con un usuario de prueba.
        Déjelo en false. Para activarlo solo en su máquina, use la opción de JVM
        -Drbo.modoDesarrollo=true en la Run Configuration de IntelliJ (ver README).
    -->
    <context-param>
        <param-name>modoDesarrollo</param-name>
        <param-value>false</param-value>
    </context-param>

    <!-- Controlador de la interfaz de empleado: login, logout y marca de asistencia. -->
    <servlet>
        <servlet-name>RboServlet</servlet-name>
        <servlet-class>sv.edu.udb.rbo.RboServlet</servlet-class>
        <!-- Arranca con la aplicación: crea el DataManager y verifica las tablas. -->
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>RboServlet</servlet-name>
        <url-pattern>/rbo</url-pattern>
    </servlet-mapping>

    <!-- Controlador de la Interfaz de Admin. -->
    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>sv.edu.udb.rbo.admin.AdminServlet</servlet-class>
        <load-on-startup>2</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin</url-pattern>
    </servlet-mapping>

    <!-- Controlador de la Interfaz de RH (empleados y tarifas). -->
    <servlet>
        <servlet-name>RHServlet</servlet-name>
        <servlet-class>sv.edu.udb.rbo.rh.RHServlet</servlet-class>
        <load-on-startup>3</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>RHServlet</servlet-name>
        <url-pattern>/rh</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <!-- Solo cookie: evita que el jsessionid aparezca en las URLs. -->
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Páginas de error (el libro las recomienda en el Capítulo 3, "More on E-bookshop"). -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/jsp/Error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/Error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/jsp/Error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/jsp/Error.jsp</location>
    </error-page>

    <!-- Pool de conexiones definido en META-INF/context.xml (Capítulo 9, eshopf). -->
    <resource-ref>
        <description>Pool de conexiones a la base rbo_marcas</description>
        <res-ref-name>jdbc/rbo</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>
</web-app>
