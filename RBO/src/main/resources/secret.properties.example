# Plantilla de secret.properties.
#
# 1. Copie este archivo como secret.properties en esta misma carpeta
#    (src/main/resources/secret.properties). Ese archivo está en el .gitignore.
# 2. Ponga la SALT que usa el equipo. Todos deben usar la MISMA SALT, si no los hashes
#    de las contraseñas no coinciden y el login falla.
#
# En lugar de este archivo, también puede definir la variable de entorno ADS_SALT.
app.salt=CAMBIE_ESTE_VALOR
